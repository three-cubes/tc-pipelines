{
  "name": "@three-cubes/tc-sdlc",
  "version": "2.2.0",
  "description": "The shared Three Cubes AI SDLC execution package.",
  "type": "module",
  "bin": {
    "tc-sdlc": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-schemas.mjs",
    "test": "vitest run"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
