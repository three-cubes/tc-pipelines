{
  "name": "@three-cubes/tc-sdlc",
  "version": "3.0.0",
  "description": "The shared Three Cubes AI SDLC execution package.",
  "type": "module",
  "bin": {
    "tc-sdlc": "bin/tc-sdlc"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-schemas.mjs",
    "release:image": "pnpm build && node ../../images/sdlc/build-release.mjs",
    "test": "vitest run --exclude test/**/*.integration.test.ts",
    "test:integration:consumers": "vitest run test/consumer-qualification.integration.test.ts",
    "test:integration:fitness": "pnpm build && vitest run test/fitness.integration.test.ts",
    "test:integration:evaluation": "vitest run test/evaluation.integration.test.ts",
    "test:integration:darwin": "vitest run test/bootstrap-darwin.integration.test.ts",
    "verify:image": "pnpm build && node ../../images/sdlc/verify.mjs"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
