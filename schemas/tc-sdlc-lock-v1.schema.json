{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://three-cubes.github.io/tc-pipelines/schemas/tc-sdlc-lock-v1.schema.json",
  "title": "Three Cubes generated SDLC lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "declarationDigest",
    "catalogueDigest",
    "release",
    "package",
    "workflowCommit",
    "imageDigest",
    "declarationSchema",
    "fitness",
    "toolchains"
  ],
  "properties": {
    "schema": { "const": "tc.sdlc/lock/v1" },
    "declarationDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "catalogueDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "@three-cubes/tc-sdlc" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "workflowCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "imageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "declarationSchema": { "const": "tc.sdlc/v1" },
    "fitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version"],
      "properties": {
        "package": { "const": "three-cubes-fitness" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "node", "packageManager", "uv"],
      "properties": {
        "python": { "const": "3.13" },
        "node": { "const": "24" },
        "packageManager": { "const": "pnpm@11.22.0" },
        "uv": { "const": "0.12.5" }
      }
    }
  }
}
