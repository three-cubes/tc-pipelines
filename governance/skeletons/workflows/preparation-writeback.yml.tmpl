---
name: "Deterministic preparation writeback"

# This privileged, default-branch workflow consumes only the receipt artifact
# from the completed Quality gate run.  It never checks out or invokes PR code.
on:
  workflow_run:
    workflows: ["Quality gate"]
    types: [completed]

permissions: {}

jobs:
  write-preparation:
    if: >-
      github.event.workflow_run.conclusion == 'success' &&
      github.event.workflow_run.event == 'pull_request'
    runs-on: ubuntu-latest
    permissions:
      actions: read
      contents: read
      id-token: write
      pull-requests: read
    steps:
      # The validator comes from the immutable tc-pipelines revision, never the
      # PR checkout.  This checkout is the only source code this job executes.
      - name: Checkout trusted receipt validator
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
        with:
          repository: three-cubes/tc-pipelines
          ref: "{{PIPELINES_SHA}}"
          path: .tc-pipelines-tools
          persist-credentials: false

      - id: source
        name: Select one current same-repository receipt artifact
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          REPOSITORY: ${{ github.repository }}
          RUN_ID: ${{ github.event.workflow_run.id }}
        run: |
          set -euo pipefail
          umask 077
          root="$RUNNER_TEMP/preparation-writeback"
          mkdir -p "$root"
          gh api "repos/${REPOSITORY}/actions/runs/${RUN_ID}" > "$root/workflow-run.json"
          read -r pr head_sha head_repository head_ref attempt < <(
            jq -er --argjson run "$RUN_ID" '
              if .id == $run and .event == "pull_request"
                and .conclusion == "success" and (.run_attempt | type == "number" and . >= 1)
                and (.pull_requests | type == "array" and length == 1)
              then [.pull_requests[0].number, .head_sha, .head_repository.full_name,
                    .head_branch, .run_attempt] | @tsv
              else error("one successful pull-request source run is required") end
            ' "$root/workflow-run.json"
          )
          [[ "$head_repository" == "$REPOSITORY" ]] || {
            echo "::error::fork preparation receipts are never written back"
            exit 1
          }
          gh api "repos/${REPOSITORY}/pulls/${pr}" > "$root/pull-request.json"
          jq -er --arg head "$head_sha" --arg repository "$REPOSITORY" '
            if .state == "open" and .head.sha == $head and .head.repo.full_name == $repository
            then true else error("pull request moved, closed, or is a fork") end
          ' "$root/pull-request.json" >/dev/null
          git check-ref-format --branch "$head_ref" >/dev/null
          name="preparation-receipt-pr${pr}-run${RUN_ID}-attempt${attempt}"
          gh api "repos/${REPOSITORY}/actions/runs/${RUN_ID}/artifacts?name=${name}&per_page=100" \
            > "$root/artifacts.json"
          artifact_id="$(jq -er --arg name "$name" --argjson run "$RUN_ID" --arg head "$head_sha" '
            [.artifacts[] | select(.name == $name and .expired == false
              and .workflow_run.id == $run and .workflow_run.head_sha == $head
              and (.digest | type == "string" and startswith("sha256:")))]
            | if length == 1 then .[0].id else error("one current receipt artifact is required") end
          ' "$root/artifacts.json")"
          {
            echo "pull_request=$pr"
            echo "head_sha=$head_sha"
            echo "head_ref=$head_ref"
            echo "workflow_run_id=$RUN_ID"
            echo "workflow_run_attempt=$attempt"
            echo "artifact_id=$artifact_id"
            echo "root=$root"
          } >> "$GITHUB_OUTPUT"

      - name: Download the bounded receipt and patch
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          REPOSITORY: ${{ github.repository }}
          ARTIFACT_ID: ${{ steps.source.outputs.artifact_id }}
          ROOT: ${{ steps.source.outputs.root }}
        run: |
          set -euo pipefail
          gh api "repos/${REPOSITORY}/actions/artifacts/${ARTIFACT_ID}/zip" > "$ROOT/receipt.zip"
          mapfile -t files < <(unzip -Z1 "$ROOT/receipt.zip")
          [[ "${#files[@]}" == 2 && "${files[0]}" == "preparation-receipt.json" && "${files[1]}" == "preparation-patch.json" ]] || {
            echo "::error::receipt artifact must contain exactly the receipt and patch"
            exit 1
          }
          unzip -p "$ROOT/receipt.zip" preparation-receipt.json > "$ROOT/preparation-receipt.json"
          unzip -p "$ROOT/receipt.zip" preparation-patch.json > "$ROOT/preparation-patch.json"

      - id: apply
        name: Validate and apply without executing PR code
        shell: bash
        env:
          REPOSITORY: ${{ github.repository }}
          PULL_REQUEST: ${{ steps.source.outputs.pull_request }}
          HEAD_SHA: ${{ steps.source.outputs.head_sha }}
          HEAD_REF: ${{ steps.source.outputs.head_ref }}
          WORKFLOW_RUN_ID: ${{ steps.source.outputs.workflow_run_id }}
          WORKFLOW_RUN_ATTEMPT: ${{ steps.source.outputs.workflow_run_attempt }}
          ROOT: ${{ steps.source.outputs.root }}
        run: |
          set -euo pipefail
          worktree="$ROOT/worktree"
          git init -q "$worktree"
          git -C "$worktree" remote add origin "https://github.com/${REPOSITORY}.git"
          git -C "$worktree" -c core.hooksPath=/dev/null fetch --depth=1 origin "$HEAD_SHA"
          git -C "$worktree" -c core.hooksPath=/dev/null checkout --detach -q "$HEAD_SHA"
          python3 .tc-pipelines-tools/governance/scripts/preparation_writeback.py apply \
            --receipt "$ROOT/preparation-receipt.json" \
            --patch "$ROOT/preparation-patch.json" \
            --repository "$REPOSITORY" \
            --pull-request "$PULL_REQUEST" \
            --expected-head "$HEAD_SHA" \
            --workflow-run-id "$WORKFLOW_RUN_ID" \
            --workflow-run-attempt "$WORKFLOW_RUN_ATTEMPT" \
            --root "$worktree"
          if git -C "$worktree" diff --quiet; then
            echo "changed=false" >> "$GITHUB_OUTPUT"
          else
            echo "changed=true" >> "$GITHUB_OUTPUT"
          fi
          echo "worktree=$worktree" >> "$GITHUB_OUTPUT"

      # No App credential exists before the immutable receipt has been checked
      # and applied in the fresh detached repository above.
      - id: app
        if: steps.apply.outputs.changed == 'true'
        name: Mint writeback token after receipt validation
        uses: three-cubes/tc-pipelines/.github/actions/github-app-token@{{PIPELINES_SHA}}
        with:
          client-id: ${{ vars.AZURE_CLIENT_ID }}
          tenant-id: ${{ vars.AZURE_TENANT_ID }}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}
          owner: ${{ github.repository_owner }}
          repositories: ${{ github.event.repository.name }}

      - name: Commit as the canonical bot and push only the exact lease
        if: steps.apply.outputs.changed == 'true'
        shell: bash
        env:
          GH_TOKEN: ${{ steps.app.outputs.token }}
          HEAD_SHA: ${{ steps.source.outputs.head_sha }}
          HEAD_REF: ${{ steps.source.outputs.head_ref }}
          PULL_REQUEST: ${{ steps.source.outputs.pull_request }}
          WORKTREE: ${{ steps.apply.outputs.worktree }}
        run: |
          set -euo pipefail
          git -C "$WORKTREE" -c core.hooksPath=/dev/null config user.name 'three-cubes-agent[bot]'
          git -C "$WORKTREE" -c core.hooksPath=/dev/null config user.email '295831460+three-cubes-agent[bot]@users.noreply.github.com'
          git -C "$WORKTREE" -c core.hooksPath=/dev/null add --all
          git -C "$WORKTREE" -c core.hooksPath=/dev/null commit -m "chore: apply deterministic preparation for PR #${PULL_REQUEST}"
          git -C "$WORKTREE" -c core.hooksPath=/dev/null push \
            --force-with-lease="refs/heads/${HEAD_REF}:${HEAD_SHA}" \
            origin "HEAD:refs/heads/${HEAD_REF}"
